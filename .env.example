# Runtime
BADCASE_ENV=development
BADCASE_DATABASE_PATH=runtime/badcase.db
BADCASE_ARTIFACTS_PATH=artifacts
BADCASE_WECOM_CLI=wecom-cli
BADCASE_WECOM_TIMEOUT_SECONDS=15
BADCASE_MAX_UPLOAD_BYTES=10485760
BADCASE_MAX_UPLOAD_ROWS=10000
BADCASE_MAX_UPLOAD_FILES=10
BADCASE_MAX_CELL_CHARS=10000
BADCASE_MAX_XLSX_ENTRIES=1000
BADCASE_MAX_XLSX_UNCOMPRESSED_BYTES=52428800

# Authentication placeholders for later P0 tasks. Never commit real values.
BADCASE_IMPORT_TOKEN=
BADCASE_REVIEWER_ALLOWLIST=

# Fixed WeCom targets for later P0 tasks. Never expose these to clients.
BADCASE_WECOM_DOCID=
BADCASE_WECOM_BIG_SHEET_ID=
BADCASE_WECOM_SMALL_SHEET_ID=
